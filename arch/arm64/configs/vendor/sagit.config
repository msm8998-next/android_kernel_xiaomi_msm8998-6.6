# Minimal Xiaomi Mi 6 (sagit / msm8998) bring-up config.
#
# This fragment is intended to be merged on top of arch/arm64/configs/defconfig.
# It enables the on-SoC blocks and the two peripherals needed for the first
# mainline-style boot: UFS rootfs and the JDI R63452 panel + Synaptics RMI4
# touchscreen.  Camera/audio/sensor bring-up is deliberately deferred.

# --- build / debug ---------------------------------------------------------
CONFIG_WERROR=n
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_LOCALVERSION="-sagit"

# --- SoC / clocks / power -------------------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM8998=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MSM_GCC_8998=y
CONFIG_MSM_MMCC_8998=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_CPR=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_PAS=y
# CONFIG_QCOM_IPA is not set
CONFIG_QCOM_WDT=y
# msm8998 has no AOSS; keep the IPA/remoteproc dependency satisfied.
CONFIG_QCOM_AOSS_QMP=n
# msm8998 has no OCMEM/LLCC; these were blocking DRM_MSM=y.
CONFIG_QCOM_OCMEM=n
CONFIG_QCOM_LLCC=n
CONFIG_INTERCONNECT=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_IOMMU_UTIL=y
CONFIG_INTERCONNECT_QCOM_DEBUG=y
# msm8998 uses RPM/RPMCC directly.  The other SoC ICC drivers are not needed
# here, and the msm8916/msm8996 ones do not build against the sm8750 ICC QoS
# API.
# CONFIG_INTERCONNECT_QCOM_MSM8916 is not set
# CONFIG_INTERCONNECT_QCOM_MSM8996 is not set
# CONFIG_INTERCONNECT_QCOM_OSM_L3 is not set
# CONFIG_INTERCONNECT_QCOM_QCM2290 is not set
# CONFIG_INTERCONNECT_QCOM_QCS404 is not set
# CONFIG_INTERCONNECT_QCOM_SM8150 is not set
# CONFIG_INTERCONNECT_QCOM_SM8250 is not set
# CONFIG_INTERCONNECT_QCOM_SM8350 is not set
# CONFIG_INTERCONNECT_QCOM_SMD_RPM is not set
CONFIG_QCOM_SOCINFO=y

# --- regulators / PMIC ----------------------------------------------------
CONFIG_REGULATOR_QCOM_SMD_RPM=y
# CONFIG_REGULATOR_QCOM_SPMI is not set
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_GDSC_REGULATOR=y

# --- storage (UFS) --------------------------------------------------------
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# Use the upstream QCOM UFS host driver with the generic QMP UFS PHY.
CONFIG_PHY_QCOM_QMP_UFS=y

# --- USB ------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_UEVENT=y

# --- display / touch ------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_JDI_R63452=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_I2C=y
CONFIG_I2C_QUP=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_2D_SENSOR=y

# --- WiFi / Bluetooth -----------------------------------------------------
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# --- Android / filesystems ------------------------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# UFS and other Qualcomm drivers use Android vendor-hook tracepoints.
CONFIG_FTRACE=y
CONFIG_ANDROID_VENDOR_HOOKS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_DM_VERITY=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y

# --- crash logs / Android userspace ---------------------------------------
# The ramoops node in msm8998-xiaomi-sagit.dts needs PSTORE_RAM; without it
# a kernel panic leaves no trace after reboot.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Android 17 userspace expects these even though the generic arm64
# defconfig leaves most of them disabled.
CONFIG_PSI=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_FUSE_FS=y
CONFIG_FS_VERITY=y
CONFIG_FS_ENCRYPTION=y
# fscrypt needs these before /data is mounted; keep them built-in.
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_XTS=y

# --- thermal / cpufreq ----------------------------------------------------
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y

# --- disable unrelated generic modules ------------------------------------
# The sm8750 defconfig enables many modules for other SoCs and form factors.
# Several of them do not build against the downstream sm8750 APIs, and none
# are needed for the Mi 6 first boot.
# CONFIG_MHI_BUS is not set
# CONFIG_CORESIGHT is not set
# CONFIG_STM is not set
# CONFIG_GNSS is not set
# CONFIG_COUNTER is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_IPMI_HANDLER is not set

# --- bring-up overrides (6.6) ---
CONFIG_MAILBOX=y
CONFIG_MSM_GPUCC_8998=y
CONFIG_QCOM_IPA=n
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=n

# Trim non-QCOM / server bloat so Image is ~20MB and boots fast
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_XEN=n
CONFIG_KVM=n
CONFIG_VIRTUALIZATION=n
CONFIG_HIBERNATION=n
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_DRM_SIMPLEDRM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_CLK_RPM=y
CONFIG_QCOM_RPMCC=y
